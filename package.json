{
  "name": "video-mirante",
  "private": true,
  "version": "1.0.0",
  "description": "Vídeo de apresentação do Espelho 3D gerado por código",
  "type": "commonjs",
  "dependencies": {
    "http-server": "^14.1.1",
    "qrcodejs": "^1.0.0",
    "three": "^0.160.0"
  },
  "scripts": {
    "video": "node scripts/pipeline.js video",
    "cena": "node scripts/pipeline.js cena",
    "montar": "node scripts/pipeline.js montar",
    "modelos": "bash scripts/baixar-modelos.sh",
    "servir": "http-server demo -p 8080 -s -c-1",
    "story": "node scripts/story.js && python3 scripts/story.py",
    "test": "node --test --test-reporter=spec testes/*.test.js",
    "ensaio": "node scripts/gravar.js --seco && node scripts/gravar.js --seco --vertical",
    "preparar": "npm install && pip install -r requirements.txt && bash scripts/baixar-modelos.sh"
  }
}